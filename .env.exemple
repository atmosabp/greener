PORT=#porta backend
PGPORT=#o mesmo do POSTGRES_PORT, geralmente. Senão: 5433
FRONT_PORT=#porta frontend (geralmente 5173 ou 8080)
ENVIRONMENT=dev

JWT_SECRET=#coloque_sua_chave_secreta_aqui

POSTGRES_HOST=#com docker: greener-database, sem docker: localhost
POSTGRES_PORT=#porta que o serviço estará rodando ex: 5432
POSTGRES_DB=#nome do banco de dados, de preferência greener_db
POSTGRES_USER=#geralmente postgres
POSTGRES_PASSWORD=#senha definida pelo time ou uma nova

ADMIN_NAME=#nome do administrador inicial - para crirar o user de admin
ADMIN_EMAIL=#email do administrador inicial - para crirar o user de admin
ADMIN_PASSWORD=#senha do administrador inicial - para crirar o user de admin